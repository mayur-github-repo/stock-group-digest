# Copy to .env (never commit .env). Only WA_GROUPS is needed day to day.

# Groups to read: comma-separated, case-insensitive substrings of the group names.
# Find exact names with:  python3 analyze.py --groups      (keep the quotes)
WA_GROUPS=""

# Seconds to let WhatsApp Web sync history after connecting (default 90).
WA_SYNC_WAIT=60

# Hard timeout for one fetch in seconds (default 240 + WA_SYNC_WAIT). Raise it for
# busy groups or long windows — a timeout exports stale data.
# WA_FETCH_TIMEOUT=900

# Max messages per export (default 800; anything over is reported, never silently dropped).
# MSD_MAX_MSGS=4000

# Retries while WhatsApp Web's chat list is still loading after a fresh link (default 8).
# WA_CHATS_RETRIES=8

# Pin a WhatsApp Web build if the current one breaks the library (rarely needed).
# WA_WEB_VERSION=

# Path to node if it isn't on PATH.
# NODE_BIN=/usr/local/bin/node
